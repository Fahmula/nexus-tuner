# Only these settings are read from the environment, everything else is on the Settings page of the web UI.
# These can be set either in this file stored as `config/.env` or as environment variables in your system.
# Values set on your system or in the docker-compose file will override these defaults.

# Non-docker users will need to change this path to match their system.
NEXUS_CONFIG_DIR=/config

# This is the port of the WEBUI and where clients will connect to the tuner.
# For docker users, NEXUS_PORT in the docker-compose file will override this.
NEXUS_PORT=4040

# Earlier versions were configured with the variables below. If they are set on the first start after upgrading,
# they are copied into settings.json once and ignored afterwards, so they can be removed.
# NEXUS_URL=http://10.1.1.23
# NEXUS_FFMPEG_PATH=/usr/bin/ffmpeg
# NEXUS_VLC_PATH=/usr/bin/vlc
# NEXUS_STREAM_ENGINE=ffmpeg
# NEXUS_REMOVE_CAPTIONS_AND_SUBTITLES=false
# NEXUS_PROCESS_INACTIVITY_TIMEOUT=900
# NEXUS_PROCESS_LOGS_RETENTION_SECONDS=86400
# NEXUS_LOG_BACKUP_COUNT=7
# NEXUS_BACKUP_COUNT=30
# NEXUS_EMBY_URL=
# NEXUS_EMBY_API_KEY=
# NEXUS_JELLYFIN_URL=
# NEXUS_JELLYFIN_API_KEY=
# NEXUS_GHOST_SESSION_CHECK_INTERVAL=60
